## PLS
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cross_decomposition import PLSRegression
from sklearn.model_selection import train_test_split, cross_val_score, KFold
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score, mean_squared_error
from skopt import gp_minimize
from skopt.space import Integer
from skopt.utils import use_named_args
import os
import warnings
warnings.filterwarnings('ignore')

# 设置matplotlib参数
plt.rcParams.update(plt.rcParamsDefault)
plt.rcParams.update({
    'font.family': 'Times New Roman',
    'font.size': 16,
    'font.weight': 'bold',
    'text.usetex': False,
    'mathtext.fontset': 'cm',
    'mathtext.default': 'bf',
    'axes.linewidth': 1.5,
    'axes.grid': False,
    'grid.alpha': 0.3,
    'legend.frameon': False,
    'legend.fontsize': 11
})

# 创建保存目录
scatter_dir = r"C:\Users\sci\1.WPT(C)\1.新文件\6.特征补充后的机器学习流程\2.机器学习模型散点图"
os.makedirs(scatter_dir, exist_ok=True)

# 1. 数据加载和预处理
print("正在加载数据...")
data = pd.read_excel("2.3.3CuFe.xlsx")
print(f"数据集形状: {data.shape}")

# 分离特征和目标变量
X = data.iloc[:, :-1]  # 前面所有列作为特征
y = data.iloc[:, -1]   # 最后一列作为目标变量

print(f"特征数量: {X.shape[1]}")
print(f"样本数量: {X.shape[0]}")

# 数据标准化
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
X_scaled = pd.DataFrame(X_scaled, columns=X.columns)

# 数据集划分 - 使用分层抽样确保分布一致
# 创建目标变量的分层标签（将连续变量分箱）
n_bins = min(5, len(y) // 5)  # 根据样本量确定分箱数
y_binned = pd.qcut(y, q=n_bins, labels=False, duplicates='drop')

X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y, test_size=0.2, random_state=42, stratify=y_binned
)

# 2. 贝叶斯优化调优PLS模型
print("\n开始贝叶斯优化...")

# 定义优化空间
space = [Integer(1, min(X.shape[1], 15), name='n_components')]

@use_named_args(space)
def objective(**params):
    """贝叶斯优化的目标函数"""
    pls = PLSRegression(n_components=params['n_components'])
    
    # 5折交叉验证
    cv = KFold(n_splits=5, shuffle=True, random_state=42)
    
    # 计算交叉验证R2
    cv_scores = cross_val_score(pls, X_train, y_train, cv=cv, scoring='r2')
    
    return -np.mean(cv_scores)  # 返回负R2，因为gp_minimize是最小化

# 执行贝叶斯优化
print("开始贝叶斯优化搜索最优参数...")
result = gp_minimize(objective, space, n_calls=20, random_state=42, verbose=False)
best_n_components = result.x[0]

print(f"\n最优成分数: {best_n_components}")
print(f"最优交叉验证R2: {-result.fun:.4f}")

# 使用最优参数计算交叉验证RMSE
print("\n使用最优参数进行交叉验证评估:")
best_pls_cv = PLSRegression(n_components=best_n_components)
cv = KFold(n_splits=5, shuffle=True, random_state=42)
cv_scores = cross_val_score(best_pls_cv, X_train, y_train, cv=cv, scoring='r2')
cv_mse_scores = -cross_val_score(best_pls_cv, X_train, y_train, cv=cv, scoring='neg_mean_squared_error')
cv_rmse_scores = np.sqrt(cv_mse_scores)

print(f"交叉验证 R² 均值: {cv_scores.mean():.4f} ± {cv_scores.std():.4f}")
print(f"交叉验证 RMSE 均值: {cv_rmse_scores.mean():.4f} ± {cv_rmse_scores.std():.4f}")

# 3. 使用最优参数构建最终模型
print("\n构建最终PLS模型...")
best_pls = PLSRegression(n_components=best_n_components)
best_pls.fit(X_train, y_train)

# 预测
y_pred_train = best_pls.predict(X_train).ravel()
y_pred_test = best_pls.predict(X_test).ravel()

# 计算评估指标
r2_train = r2_score(y_train, y_pred_train)
r2_test = r2_score(y_test, y_pred_test)
rmse_train = np.sqrt(mean_squared_error(y_train, y_pred_train))
rmse_test = np.sqrt(mean_squared_error(y_test, y_pred_test))

print(f"\n模型性能评估:")
print(f"训练集 R²: {r2_train:.4f}")
print(f"测试集 R²: {r2_test:.4f}")
print(f"训练集 RMSE: {rmse_train:.4f}")
print(f"测试集 RMSE: {rmse_test:.4f}")

# 4. 绘制预测值vs真实值散点图
print("\n绘制散点图...")
fig, ax = plt.subplots(figsize=(6, 5))

# 计算绘图范围
all_values = np.concatenate([y_train.values, y_test.values, y_pred_train, y_pred_test])
min_val = np.floor(all_values.min())
max_val = np.ceil(all_values.max())

# 绘制数据点
ax.scatter(y_train, y_pred_train, c='#1E4C9C', label='Train data', 
           edgecolor='black', s=50, alpha=1, zorder=1)
ax.scatter(y_test, y_pred_test, c='#FCBB44', label='Test data', 
           edgecolor='black', s=50, alpha=1, zorder=2)
ax.plot([min_val, max_val], [min_val, max_val], linestyle='--', 
         color='black', label='y=x', linewidth=1.5, zorder=3)

# 设置轴范围和标签
ax.set_xlim(min_val, max_val)
ax.set_ylim(min_val, max_val)
ax.set_xlabel('Experimental values (%)', fontweight='bold', labelpad=5)
ax.set_ylabel('Predicted values (%)', fontweight='bold', labelpad=5)
ax.set_title('PLS Regression', fontweight='bold', pad=5)

# 添加图例和统计信息
ax.legend(loc='best', fontsize=12)
ax.text(0.05, 0.95, f'Test R² = {r2_test:.3f}\nTest RMSE = {rmse_test:.3f}',
        transform=ax.transAxes, verticalalignment='top',
        bbox=dict(facecolor='white', alpha=0.8))

# 调整刻度和布局
ax.tick_params(which='major', direction='out', length=3, width=1.5)
ax.tick_params(which='minor', direction='out', length=3, width=1.5)
plt.tight_layout()

# 保存图片
file_name = "2.3.3cm_PLS_Optimized.tiff"
full_path = os.path.join(scatter_dir, file_name)
fig.savefig(full_path, format='tiff', dpi=400, bbox_inches='tight', pad_inches=0.1)
plt.show()

print(f"\n散点图已保存到: {full_path}")


