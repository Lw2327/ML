                marker='o', markersize=3, markevery=len(original_grid)//10)
        
        # 填充曲线与零线之间的区域
        ax.fill_between(original_grid, pdp_centered, 0, alpha=0.2, color=color)
        
        # 添加零线
        ax.axhline(y=0, color='black', linestyle='-', alpha=0.5, linewidth=1)
        
        # 添加特征分布
