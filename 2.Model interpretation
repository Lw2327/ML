            standardized_point = scaler.transform(temp_point)[0, feature_idx]
            X_test_point[feat_name] = standardized_point
            
            # 预测C6+OH选择性
            predictions = best_xgb.predict(X_test_point)
            pdp_value = np.mean(predictions)
            pdp_values.append(pdp_value)
        
        # 计算相对于基准的标准化影响
        pdp_centered = np.array(pdp_values) - baseline_prediction
        
        # 创建图形
        fig, ax = plt.subplots(figsize=(6, 5))
        
        # 绘制PDP曲线
