def create_half_violin_with_half_scatter(ax, data, position, width=0.5, color='steelblue', 
                                         alpha=0.4, scatter_alpha=0.25, scatter_size=8):
    """创建只有右半边的小提琴图，并且散点也只保留右半边"""
    
    y_min, y_max = data.min(), data.max()
    y_range = y_max - y_min
    y_vals = np.linspace(y_min - y_range * 0.05, y_max + y_range * 0.05, 200)
    
    try:
        density = stats.gaussian_kde(data)
        density_vals = density(y_vals)
        if density_vals.max() > 0:
            density_norm = density_vals / density_vals.max() * (width / 2)
        else:
            density_norm = np.zeros_like(density_vals)
    except:
        density_norm = np.full_like(y_vals, width / 4)
    
    vertices = []
    for i in range(len(y_vals)):
        vertices.append([position + density_norm[i], y_vals[i]])
    vertices.append([position, y_vals[-1]])
    vertices.append([position, y_vals[0]])
    vertices = np.array(vertices)
    
    if len(vertices) > 0:
        violin_polygon = Polygon(vertices, facecolor=color, alpha=alpha, 
                                 edgecolor='black', linewidth=1.5, zorder=3)
        ax.add_patch(violin_polygon)
    
    n_points = len(data)
    right_half_width = width * 0.4
    jitter = np.random.uniform(0, right_half_width, n_points)
    scatter_x = position + jitter
    scatter_y = data
    
    ax.scatter(scatter_x, scatter_y, c=color, alpha=scatter_alpha, 
              s=scatter_size, edgecolors='none', linewidth=0, zorder=2)
    
    ax.axvline(x=position, color='gray', linestyle='--', linewidth=1, alpha=0.5, zorder=1)
    
    return violin_polygon

